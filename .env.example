# Telegram
BOT_TOKEN=
SUPERADMIN_IDS=
TIMEZONE=Europe/Kyiv
BOT_NAME=АМПасадори / АМП XP
ORGANIZATION_NAME=Анисівський молодіжний простір

# Постійне сховище даних.
# На Mac за замовчуванням використовується ~/AMP_Bot_Data,
# тому база та фото не залежать від папки конкретної версії.
AMP_DATA_DIR=~/AMP_Bot_Data

# Залиште цей старий SQLite-рядок або приберіть його — v1.3 автоматично
# перенаправляє стандартний локальний SQLite у AMP_DATA_DIR.
DATABASE_URL=sqlite+aiosqlite:///./data/amp_bot.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+asyncpg://amp:CHANGE_ME@db:5432/ampxp

# Media storage: locally leave blank/local; on Heroku set to database.
MEDIA_STORAGE=

# Web admin
PUBLIC_BASE_URL=http://localhost:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
# WEB_ADMIN_* — legacy/bootstrap-only для першого запуску v1.7.3.
# Після успішного перенесення акаунта в таблицю web_staff_accounts видаліть WEB_ADMIN_PASSWORD з Heroku Config Vars.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Необов’язково: іменні облікові записи звичайних адміністраторів.
# Вони бачать базові дані, масковані контакти й не мають доступу до
# категорій вразливості, повної дати народження, модерації, журналу доступу
# та розширених Excel. Формат — JSON в один рядок.
# WEB_STAFF_ACCOUNTS_JSON — legacy/bootstrap-only для автоматичного перенесення старих staff-акаунтів у БД.
# Після перевірки входу всіх адміністраторів змінну рекомендовано видалити.
# WEB_STAFF_ACCOUNTS_JSON={"ivan":{"password":"CHANGE_ME_1","display_name":"Іван Галуза"}}
WEB_STAFF_ACCOUNTS_JSON=

WEB_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
COOKIE_SECURE=0

# Season XP
SEASON_NAME=Сезон 2026/27
SEASON_START=2026-09-01
SEASON_END=2027-08-31

# Heroku production overrides (set as config vars, do not commit secrets):
# PUBLIC_BASE_URL=https://amp-bot-ver-1-5-0-9632a1434a6d.herokuapp.com
# MEDIA_STORAGE=database
# COOKIE_SECURE=1
# PORT is assigned automatically by Heroku.
# DATABASE_URL is assigned automatically by the Heroku Postgres add-on.
