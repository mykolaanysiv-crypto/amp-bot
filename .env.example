# Telegram
BOT_TOKEN=
SUPERADMIN_IDS=
TIMEZONE=Europe/Kyiv
BOT_NAME=АМПасадори / АМП XP
ORGANIZATION_NAME=Анисівський молодіжний простір

# Постійне сховище даних.
# На Mac за замовчуванням використовується ~/AMP_Bot_Data,
# тому база та фото не залежать від папки конкретної версії.
AMP_DATA_DIR=~/AMP_Bot_Data

# Залиште цей старий SQLite-рядок або приберіть його — v1.3 автоматично
# перенаправляє стандартний локальний SQLite у AMP_DATA_DIR.
DATABASE_URL=sqlite+aiosqlite:///./data/amp_bot.db
# Приклад PostgreSQL для робочого сервера:
# DATABASE_URL=postgresql+asyncpg://amp:CHANGE_ME@db:5432/ampxp

# Сховище медіа: локально залиште порожнім/local; на Heroku встановіть database.
MEDIA_STORAGE=

# Вебадміністрування
PUBLIC_BASE_URL=http://localhost:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
# WEB_ADMIN_* — legacy/bootstrap-only для першого запуску v1.7.3.
# Після успішного перенесення акаунта в таблицю web_staff_accounts видаліть WEB_ADMIN_PASSWORD з Heroku Config Vars.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Необов’язково: іменні облікові записи звичайних адміністраторів.
# Вони бачать базові дані, масковані контакти й не мають доступу до
# категорій вразливості, повної дати народження, модерації, журналу доступу
# та розширених Excel. Формат — JSON в один рядок.
# WEB_STAFF_ACCOUNTS_JSON — legacy/bootstrap-only для автоматичного перенесення старих staff-акаунтів у БД.
# Після перевірки входу всіх адміністраторів змінну рекомендовано видалити.
# WEB_STAFF_ACCOUNTS_JSON={"ivan":{"password":"CHANGE_ME_1","display_name":"Іван Галуза"}}
WEB_STAFF_ACCOUNTS_JSON=

WEB_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
COOKIE_SECURE=0

# Сезонний XP
SEASON_NAME=Сезон 2026/27
SEASON_START=2026-09-01
SEASON_END=2027-08-31

# Налаштування Heroku для робочого середовища (задавайте як Config Vars, секрети не додавайте до Git):
# PUBLIC_BASE_URL=https://amp-bot-ver-1-5-0-9632a1434a6d.herokuapp.com
# MEDIA_STORAGE=database
# COOKIE_SECURE=1
# PORT Heroku призначає автоматично.
# DATABASE_URL автоматично задає доповнення Heroku Postgres.

# v1.10.4 — підтримка АМП / Monobank jar
DONATION_JAR_URL=https://send.monobank.ua/jar/5S531LWQuc
# Особистий токен Monobank Open API власника банки. Зберігайте в секреті та не додавайте до Git.
MONOBANK_TOKEN=
# v1.12.0 — production observability (optional)
# Heroku logs use JSON automatically when DYNO is present.
LOG_LEVEL=INFO
LOG_FORMAT=
APP_ENV=production
# Optional Sentry error monitoring. Keep the DSN only in Config Vars / local .env.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# APP_RELEASE may be set by your deploy pipeline; not required.
APP_RELEASE=

# v1.12.1 — Production Stability Gate / PostgreSQL pools / runtime health
# Невеликі ліміти задаються на КОЖЕН dyno окремо. Для 1 web + 1 worker
# значення 3+2 залишають запас для release dyno і службових підключень.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Heartbeat worker кожні 30 с; після 120 с без heartbeat worker вважається недоступним.
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_SECONDS=120
# Timeout SELECT 1 для health readiness/dependencies.
HEALTH_PROBE_TIMEOUT_SECONDS=3
# Після deploy даємо worker до 180 с на створення heartbeat усіх scheduler.
HEALTH_STARTUP_GRACE_SECONDS=180
# Повторний alarm суперадміну про той самий dead scheduler не частіше 1 раз/год.
SCHEDULER_ALERT_REPEAT_SECONDS=3600
# Після першого запуску без маркера backup не надсилаємо false-positive alert одразу.
BACKUP_UNKNOWN_GRACE_HOURS=24

